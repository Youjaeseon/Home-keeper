# FastAPI runtime role. Must be able to read/write app tables only.
DATABASE_URL=postgresql://career_pair_runtime:change-me@localhost:5432/career_pair

# Admin/migration connection. Needed only for `python -m app.migrate`.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/career_pair

# Supabase Auth project. Issuer is SUPABASE_URL + /auth/v1.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public publishable/anon key for Scalar email/password login (never service_role).
SUPABASE_PUBLISHABLE_KEY=
# Required only for legacy HS256 tokens. Asymmetric tokens are verified via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override for custom domains or local Supabase.
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Optional: Gov24 Open API service key for support-program sync.
# Keep this only in the server environment; never expose it to the mobile app.
GOV24_API_KEY=

# Optional: server-side LLM for landlord/provider request drafts.
# OpenAPI-compatible Chat Completions endpoint. Without a key, draft generation
# returns 503 and the template API keeps working. Never expose this to the app.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Optional photo detection. Paths are relative to apps/api when using npm run api.
# Install with: uv sync --directory apps/api --extra vision
# Checkpoints are trusted server files; never accept weights from an upload.
YOLO_MODEL_PATH=../../models/best.pt
# Server only. SAM is called only with external_analysis_consent=true.
MODEL_API_KEY=
SAM_TIMEOUT_SECONDS=30
