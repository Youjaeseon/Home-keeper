# FastAPI에게 보낼 주소. 실제 기기에서는 Mac의 LAN IP를 사용한다.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# FastAPI의 SUPABASE_URL과 같은 Supabase 프로젝트여야 한다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key 또는 기존 anon key. service_role 키는 절대 넣지 않는다.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
